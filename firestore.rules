rules_version = '2';

// Homens | Família & Legado — security rules.
// Access levels per map:
//   - owner: full control (delete, manage sharing)
//   - member_emails: listed e-mails can read and edit
//   - shared_with_all: any signed-in account can read and edit
// Ownership and the sharing settings themselves can only be changed by the owner.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return signedIn() && data.owner_id == request.auth.uid;
    }

    function isMember(data) {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in data.get('member_emails', []);
    }

    function isCommunity(data) {
      return signedIn() && data.get('shared_with_all', false) == true;
    }

    function canRead(data) {
      return isOwner(data) || isMember(data) || isCommunity(data);
    }

    function sharingUnchanged() {
      return request.resource.data.get('member_emails', []) == resource.data.get('member_emails', [])
        && request.resource.data.get('shared_with_all', false) == resource.data.get('shared_with_all', false);
    }

    function canAccessMap(mapId) {
      let data = get(/databases/$(database)/documents/maps/$(mapId)).data;
      return isOwner(data) || isMember(data) || isCommunity(data);
    }

    match /maps/{mapId} {
      allow read: if canRead(resource.data);
      allow create: if signedIn() && request.resource.data.owner_id == request.auth.uid;
      // Members/community may edit map metadata, but never the ownership nor
      // the sharing settings — those belong to the owner.
      allow update: if request.resource.data.owner_id == resource.data.owner_id
        && (isOwner(resource.data)
            || ((isMember(resource.data) || isCommunity(resource.data)) && sharingUnchanged()));
      allow delete: if isOwner(resource.data);

      match /nodes/{nodeId} {
        allow read, write: if canAccessMap(mapId);
      }

      match /versions/{versionId} {
        allow read, write: if canAccessMap(mapId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
