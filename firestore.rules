rules_version = '2';

// Homens | Família & Legado — security rules.
// The owner has full control; people listed in `member_emails` can read and
// edit the map and its nodes (shared family/group maps). Only the owner can
// delete the map or change its ownership.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return signedIn() && data.owner_id == request.auth.uid;
    }

    function isMember(data) {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in data.get('member_emails', []);
    }

    function canAccessMap(mapId) {
      let data = get(/databases/$(database)/documents/maps/$(mapId)).data;
      return isOwner(data) || isMember(data);
    }

    match /maps/{mapId} {
      allow read: if isOwner(resource.data) || isMember(resource.data);
      allow create: if signedIn() && request.resource.data.owner_id == request.auth.uid;
      // Members may edit map metadata, but ownership can never change hands.
      allow update: if (isOwner(resource.data) || isMember(resource.data))
        && request.resource.data.owner_id == resource.data.owner_id;
      allow delete: if isOwner(resource.data);

      match /nodes/{nodeId} {
        allow read, write: if canAccessMap(mapId);
      }

      match /versions/{versionId} {
        allow read, write: if canAccessMap(mapId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
